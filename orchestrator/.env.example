# Required — the app will refuse to start if any of these three are missing.
RAG_URL=http://localhost:8001
MEMORY_URL=http://localhost:8000
SEARXNG_URL=http://localhost:8080

# Optional — sensible defaults are used if these are left unset.
RAG_TIMEOUT_SECONDS=30
GRAPH_TIMEOUT_SECONDS=30
WEB_TIMEOUT_SECONDS=15

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:3000
