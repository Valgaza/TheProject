# ── Neo4j ─────────────────────────────────────────────────────────────────────
# Credentials used by both docker-compose and the Python driver.
# docker-compose reads NEO4J_USERNAME/NEO4J_PASSWORD to set NEO4J_AUTH inside
# the container; the Python driver uses NEO4J_URI + the same credentials.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=nexus-local

# ── Models ────────────────────────────────────────────────────────────────────
# Every model runs locally on MLX inside the runtime service (runtime/, :8003),
# which start.sh launches first. Core and graphiti reach it through the OpenAI
# SDK, so pointing them at it is this one URL; OPENAI_API_KEY is set to the
# service token further down, after SERVICE_TOKEN is defined.
#
# Never leave this as "=" with nothing after it: load_dotenv() turns a blank
# line into an empty string, which the openai SDK and graphiti's embedder treat
# as a real (hostless) URL rather than unset. Found 2026-09-02.
OPENAI_BASE_URL=http://localhost:8003/v1
# Fallback while MLX is being proven: Ollama. start.sh starts Ollama instead of
# the runtime when this points at :11434, and the model names below must then
# be Ollama tags (gpt-oss:20b, nomic-embed-text).
# OPENAI_BASE_URL=http://localhost:11434/v1

# Model names live here, never in code. With the runtime they are Hugging Face
# ids of MLX conversions; the runtime downloads them on first start and serves
# them under exactly these names. All three LLM roles share one resident model.
CORE_CHAT_MODEL=mlx-community/Qwen3-8B-4bit
CORE_EMBED_MODEL=mlx-community/embeddinggemma-300m-4bit
# The memory write gate runs as its own cheap call, so it can later be served by
# a small local model while answering stays on a bigger one.
CORE_GATE_MODEL=mlx-community/Qwen3-8B-4bit

# ── Postgres ──────────────────────────────────────────────────────────────────
# Postgres stores what was said (every message, always). Neo4j stores what was
# learned (gated by the memory write gate). Two stores, two jobs.
#
# The postgres container in docker-compose.yml, with these exact credentials.
# A hosted Postgres works too: prefer its transaction pooler, which
# core/nexus_core/db.py already disables prepared statements for.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_ECHO=0

# Real auth landed 2026-09-02 (see db/migrations/20260902000000_*.sql).
# DEMO_USER_ID now only matters for tests, which authenticate as this exact
# seeded account rather than going through real signup. Login as it directly
# in the app too: demo@example.com / nexus-demo.
DEMO_USER_ID=00000000-0000-0000-0000-000000000001

# ── Auth ──────────────────────────────────────────────────────────────────────
# Signs the session cookie (see core/nexus_core/auth.py) and, reused, Authlib's
# short-lived OAuth handshake state. Required -- the app refuses to start
# without it, rather than silently running with a guessable default.
#
# Deliberately NOT a real value here, even a placeholder-looking one --
# an example secret that actually works is exactly the kind of thing
# someone copies straight into production without regenerating it. Generate
# your own: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_ME_run_the_python_command_above_to_generate_a_real_one

# Shared by core, memory and RAG. Memory and RAG refuse every request that
# doesn't carry it, and core sends it on each call, so the browser can only
# reach them through core, which knows who is signed in. Required by all three.
# Generate it the same way: python3 -c "import secrets; print(secrets.token_hex(32))"
SERVICE_TOKEN=REPLACE_ME_run_the_python_command_above_to_generate_a_real_one
# The runtime accepts the same token as an OpenAI-style API key, which is how
# core and graphiti authenticate to it. Must come after SERVICE_TOKEN:
# interpolation only sees variables defined above it.
OPENAI_API_KEY=${SERVICE_TOKEN}

# How long a session stays valid before the user has to log in again.
SESSION_MAX_AGE_SECONDS=2592000

# "1" only once this is served over https. Browsers refuse to store or send a
# Secure cookie over plain http at all, so leave this "0" for local dev.
SESSION_COOKIE_SECURE=0

# Optional — email/password works with both left blank. Set both to enable
# "Sign in with Google": create an OAuth 2.0 Client ID at
# console.cloud.google.com, authorized redirect URI
# http://localhost:8100/auth/google/callback for local dev.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where the browser lands after a Google sign-in redirect completes.
FRONTEND_URL=http://localhost:3000

# ── Memory service ────────────────────────────────────────────────────────────
# The model graphiti uses to extract entities and relationships from an episode.
# Not the model that answers the user -- that one is CORE_CHAT_MODEL.
MEMORY_EXTRACTION_MODEL=mlx-community/Qwen3-8B-4bit
# 768-dimensional, matching EMBEDDING_DIM below. Changing the embedding model
# changes what every stored vector means: re-embed the graph afterwards
# (scripts/reembed_graph.py) or similarity compares unrelated spaces.
MEMORY_EMBEDDING_MODEL=mlx-community/embeddinggemma-300m-4bit

# graphiti reads EMBEDDING_DIM at import time, defaults it to 1024, and slices
# every vector to that length -- which silently truncated text-embedding-3-small
# from its native 1536. Pinned here, and passed explicitly in code so it does not
# depend on import order.
#
# Changing this invalidates every vector already stored: similarity is only
# meaningful between vectors of the same length. Treat it as fixed once the graph
# holds anything you care about.
EMBEDDING_DIM=768

# Cosine floor for retrieval, specific to the embedding model: re-measure it
# (scripts/floor_sweep.py) whenever MEMORY_EMBEDDING_MODEL changes. 0.40 for
# EmbeddingGemma; the measurements are in memory/nexus_memory/retrieval.py.
MEMORY_SEARCH_MIN_SCORE=0.40

# ── Service wiring ────────────────────────────────────────────────────────────
CORE_PORT=8100
MEMORY_SERVICE_URL=http://localhost:8000
# The RAG API (rag/rag_api.py, backed by rag/rag_pipeline). Queried on every
# turn by core/nexus_core/rag_client.py; CORE_RAG_MIN_SCORE decides whether
# what comes back reaches the prompt.
RAG_SERVICE_URL=http://localhost:8001
CORE_RAG_MIN_SCORE=0.5
# Self-hosted SearXNG (the searxng container in docker-compose.yml), reached
# only through core/nexus_core/web_client.py, and only when the person asks:
# the composer's web button or saying so in words. The query is redacted
# before it leaves; see flag 1 in docs/IMPORTANT_BUSINESS_LOGIC_FLAGS.md.
SEARXNG_URL=http://localhost:8080
CORE_CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# ── RAG pipeline ──────────────────────────────────────────────────────────────
# Read by rag/rag_api.py from this file. The values shown are the defaults in
# rag/rag_pipeline/config.py; uncomment one only to change it. A rag/.env, if
# present, still overrides these, but nothing needs one.
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
# QDRANT_COLLECTION_NAME=rag_documents
# QDRANT_USE_MEMORY=false
# Embeddings run in-process on CPU (fastembed / ONNX).
# DENSE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# SPARSE_EMBEDDING_MODEL=Qdrant/bm25
# EMBEDDING_BATCH_SIZE=64
# CHUNK_SIZE=512
# CHUNK_OVERLAP=50
# RETRIEVAL_TOP_K=20
# RERANK_TOP_N=5
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-12-v2
# MAX_CONTEXT_TOKENS=3000
