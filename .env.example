# ── Neo4j ─────────────────────────────────────────────────────────────────────
# Credentials used by both docker-compose and the Python driver.
# docker-compose reads NEO4J_USERNAME/NEO4J_PASSWORD to set NEO4J_AUTH inside
# the container; the Python driver uses NEO4J_URI + the same credentials.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=nexus-local

# ── Models ────────────────────────────────────────────────────────────────────
# One key drives graphiti's extraction (memory service) and the core service's
# chat + embeddings.
# Inference is local (Ollama). Both configs _require_ this to be non-empty,
# but Ollama never reads it -- it is a placeholder, not a credential.
OPENAI_API_KEY=ollama-local-no-key-needed

# Point this at an OpenAI-compatible server (Ollama, vLLM, LM Studio) to move
# inference local. Leave commented out (not "=" with nothing after it) for
# the real OpenAI API -- load_dotenv() sets a present-but-blank line to an
# actual empty string in the process environment, and both the openai SDK's
# own base_url fallback and graphiti_core's OpenAIEmbedder treat "present
# but empty" as a real override rather than "unset", silently sending every
# request to no host at all (httpx.UnsupportedProtocol, surfaced as a
# generic connection error with no mention of base_url). Found 2026-09-02
# after it broke both core's chat endpoint and memory's /search.
# OPENAI_BASE_URL=
# For Ollama, uncomment and point it at the local server:
# OPENAI_BASE_URL=http://localhost:11434/v1

# Model names live here, never in code, so the local swap stays a config change.
CORE_CHAT_MODEL=gpt-oss:20b
CORE_EMBED_MODEL=nomic-embed-text
# The memory write gate runs as its own cheap call, so it can later be served by
# a small local model while answering stays on a bigger one.
CORE_GATE_MODEL=gpt-oss:20b

# ── Supabase (Postgres) ───────────────────────────────────────────────────────
# Postgres stores what was said (every message, always). Neo4j stores what was
# learned (gated by the memory write gate). Two stores, two jobs.
#
# Local development: run `supabase start` and use the URL below verbatim -- those
# are the standard local stack credentials, identical on every machine.
# Hosted: copy the connection string from Project Settings -> Database. Prefer
# the transaction pooler; prepared statements are already disabled for it in
# core/app/db.py.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_ECHO=0

# Real auth landed 2026-09-02 (see supabase/migrations/20260902000000_*.sql).
# DEMO_USER_ID now only matters for tests, which authenticate as this exact
# seeded account rather than going through real signup. Login as it directly
# in the app too: demo@example.com / nexus-demo.
DEMO_USER_ID=00000000-0000-0000-0000-000000000001

# Not currently used -- kept in case Supabase Auth specifically (not just
# Supabase's Postgres, which this project stopped using 2026-09-02) is ever
# wanted as a self-hosted piece later. See JWT_SECRET below for the auth
# that's actually live right now.
# WARNING: the service role key bypasses row level security completely. It
# belongs to the core service only -- never put it in a NEXT_PUBLIC_* variable
# or anywhere it can reach the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Auth ──────────────────────────────────────────────────────────────────────
# Signs the session cookie (see core/nexus_core/auth.py) and, reused, Authlib's
# short-lived OAuth handshake state. Required -- the app refuses to start
# without it, rather than silently running with a guessable default.
#
# Deliberately NOT a real value here, even a placeholder-looking one --
# an example secret that actually works is exactly the kind of thing
# someone copies straight into production without regenerating it. Generate
# your own: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_ME_run_the_python_command_above_to_generate_a_real_one

# How long a session stays valid before the user has to log in again.
SESSION_MAX_AGE_SECONDS=2592000

# "1" only once this is served over https. Browsers refuse to store or send a
# Secure cookie over plain http at all, so leave this "0" for local dev.
SESSION_COOKIE_SECURE=0

# Optional — email/password works with both left blank. Set both to enable
# "Sign in with Google": create an OAuth 2.0 Client ID at
# console.cloud.google.com, authorized redirect URI
# http://localhost:8100/auth/google/callback for local dev.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where the browser lands after a Google sign-in redirect completes.
FRONTEND_URL=http://localhost:3000

# ── Memory service ────────────────────────────────────────────────────────────
# The model graphiti uses to extract entities and relationships from an episode.
# Not the model that answers the user -- that one is CORE_CHAT_MODEL.
MEMORY_EXTRACTION_MODEL=gpt-oss:20b
MEMORY_EMBEDDING_MODEL=nomic-embed-text

# graphiti reads EMBEDDING_DIM at import time, defaults it to 1024, and slices
# every vector to that length -- which silently truncated text-embedding-3-small
# from its native 1536. Pinned here, and passed explicitly in code so it does not
# depend on import order.
#
# Changing this invalidates every vector already stored: similarity is only
# meaningful between vectors of the same length. Treat it as fixed once the graph
# holds anything you care about.
EMBEDDING_DIM=768

# Cosine floor for retrieval. Lowered from graphiti's default of 0.6 after
# measuring: on a five-fact corpus, 0.6 recalled 2 of 6 real questions and 0.45
# recalled 5, including direct ones like "what languages do I write in?".
# See memory/nexus_memory/retrieval.py for the full sweep.
MEMORY_SEARCH_MIN_SCORE=0.45

# ── Service wiring ────────────────────────────────────────────────────────────
CORE_PORT=8100
MEMORY_SERVICE_URL=http://localhost:8000
# The RAG API (RAG/rag_api.py, backed by RAG/rag_pipeline). Used by
# core/nexus_core/rag_client.py, wired into select_route()/chat_service.py.
RAG_SERVICE_URL=http://localhost:8001
CORE_CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
